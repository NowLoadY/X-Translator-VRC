{
  "asr": {
    "provider": "qwen3-gguf",
    "providers": {
      "qwen3-gguf": {
        "model_asset": "qwen3-asr-gguf",
        "prompt_field": "prompt",
        "supports_language": true,
        "supports_prompt": true,
        "url": "http://127.0.0.1:8001/v1/chat/completions"
      }
    },
    "vad_adaptive_after_ms": 4000,
    "vad_adaptive_silence_ms": 128,
    "vad_max_utterance_ms": 8000,
    "vad_overlap_ms": 256,
    "vad_silence_ms": 320,
    "vad_threshold": 0.6
  },
  "audio": {
    "pre_buffer_frames": 20,
    "sample_rate": 16000,
    "tts_sample_rate": 48000
  },
  "frontend": {
    "show_speaker": false
  },
  "model_manager": {
    "hunyuan_gguf_repo": "tencent/Hy-MT2-1.8B-GGUF",
    "llama_cpp": {
      "downloads": [
        {
          "name": "llama-b10333-bin-win-cpu-x64.zip",
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b10333/llama-b10333-bin-win-cpu-x64.zip"
        },
        {
          "name": "llama-b10333-bin-win-cuda-12.4-x64.zip",
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b10333/llama-b10333-bin-win-cuda-12.4-x64.zip"
        },
        {
          "name": "cudart-llama-bin-win-cuda-12.4-x64.zip",
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b10333/cudart-llama-bin-win-cuda-12.4-x64.zip"
        },
        {
          "name": "llama-b10333-bin-win-cuda-13.3-x64.zip",
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b10333/llama-b10333-bin-win-cuda-13.3-x64.zip"
        },
        {
          "name": "cudart-llama-bin-win-cuda-13.3-x64.zip",
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b10333/cudart-llama-bin-win-cuda-13.3-x64.zip"
        }
      ],
      "release": "b10333",
      "release_page": "https://github.com/ggml-org/llama.cpp/releases/tag/b10333"
    },
    "llama_server_path": "D:\\app_install_path\\AI\\llama.cpp\\llama-server.exe"
  },
  "osc": {
    "enabled": true,
    "history_ttl_seconds": 15.0,
    "ip": "127.0.0.1",
    "listen_port": 9001,
    "max_text_length": 144,
    "send_port": 9000
  },
  "prompt_context": {
    "enabled": true,
    "max_entries": 6,
    "translation_max_chars": 600
  },
  "server": {
    "host": "0.0.0.0",
    "port": 7654
  },
  "speaker": {
    "enabled": true,
    "intra_threads": 2,
    "max_speakers": 8,
    "min_utterance_ms": 500,
    "model_path": "models/3D-Speaker-ERes2NetV2/speaker_embedding.onnx",
    "same_speaker_hysteresis": 0.04,
    "similarity_threshold": 0.62
  },
  "storage": {
    "log_dir": "runtime/logs"
  },
  "translation": {
    "emit_interval_seconds": 0.8,
    "emit_min_chars": 6,
    "provider": "hunyuan",
    "providers": {
      "hunyuan": {
        "max_tokens": 256,
        "model": "Hy-MT2",
        "model_asset": "hy-mt2",
        "supports_prompt_context": true,
        "url": "http://127.0.0.1:8002/v1/chat/completions"
      }
    },
    "source_lang": "auto",
    "target_lang": "zh,en"
  },
  "tts": {
    "provider": "none",
    "providers": {}
  }
}
